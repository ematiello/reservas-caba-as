# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* are inlined at build time: set them before `npm run build`.

# Supabase project URL (dev project; production uses its own project)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...). Safe for the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave-aqui